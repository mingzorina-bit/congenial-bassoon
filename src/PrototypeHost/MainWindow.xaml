<Window x:Class="BilingualInput.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Padding="36" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel Spacing="8">
   <TextBlock Text="Bilingual Input" FontSize="30" FontWeight="SemiBold"/>
   <TextBlock Text="熟悉的输入，从这里开始。" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
  <ComboBox x:Name="ThemeChoice" Header="外观" HorizontalAlignment="Right" Width="120" SelectedIndex="0" SelectionChanged="ThemeChanged">
    <ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
  </ComboBox></Grid>
  <Border Grid.Row="1" Margin="0,24,0,18" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
   <StackPanel Spacing="5">
    <TextBlock Text="v0.0.1 · 候选输入体验" FontWeight="SemiBold"/>
    <TextBlock Text="试着输入 youhua、xuexi 或 gongzuo。空格提交候选，Enter 保留原文。" TextWrapping="Wrap"/>
    <TextBlock Text="本阶段使用有限原型词表；双语 Shadow 将在下一阶段加入。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBox x:Name="Editor" PlaceholderText="在这里连续输入…" AcceptsReturn="True" TextWrapping="Wrap"
     FontSize="20" Padding="20" VerticalContentAlignment="Top" IsSpellCheckEnabled="False"
     IsTextPredictionEnabled="False" IsEnabled="False" PreviewKeyDown="EditorKeyDown"/>
   <Border Grid.Row="1" x:Name="CandidateCard" Margin="0,12,0,0" Padding="16" CornerRadius="8"
      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" HorizontalAlignment="Left" MinWidth="380">
    <StackPanel Spacing="10">
     <TextBlock x:Name="Composition" Text="准备输入" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <StackPanel x:Name="CandidateRow" Orientation="Horizontal" Spacing="6"/>
     <TextBlock Text="Space 选中  ·  1–5 选择  ·  ← → 导航  ·  Enter 原文" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </StackPanel>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="Status" Text="正在准备本地输入…" Margin="0,16,0,0" FontSize="12" TextWrapping="Wrap"
    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 </Grid>
</Window>
